{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "finitless-brand-guidelines",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./apps/brand-page/out",
